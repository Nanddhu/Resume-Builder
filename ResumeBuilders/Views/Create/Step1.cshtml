@{
    ViewData["Title"] = "Step 1 - Resume Details";
    Layout = "~/Views/Create/Index.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        * {
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            margin: 0;
            background: #ffffff;
        }

        .form-card {
            background: #fff;
            padding: 40px;
            border-radius: 14px;
            box-shadow: 0 20px 40px rgba(0,0,0,.1);
            max-width: 900px;
            margin: auto;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h2 {
            color: #1f2937;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #6b7280;
        }

        .profile-upload {
            position: relative;
            width: 110px;
            height: 110px;
        }

            .profile-upload img {
                width: 110px;
                height: 110px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #e5e7eb;
                cursor: pointer;
            }

            .profile-upload input {
                display: none;
            }

        .upload-text {
            position: absolute;
            bottom: -18px;
            width: 100%;
            text-align: center;
            font-size: 12px;
            color: #1975B8;
        }

        .row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .field {
            flex: 1 1 48%;
            min-width: 280px;
        }

        label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 6px;
            color: #374151;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #d1d5db;
        }

        textarea {
            resize: none;
        }

        .actions {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }

        .btn {
            padding: 14px 30px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #1975B8;
            color: #fff;
        }

        .btn-secondary {
            background: #f3e6ec;
            color: #1975B8;
        }
    </style>
</head>

<body>

    <div class="form-card">

        <div class="header-row">
            <div>
                <h2>Candidate Details</h2>
                <p class="subtitle">Basic information</p>
            </div>

            <div class="profile-upload">
                <label for="profileImage">
                    <img id="profilePreview" src="https://via.placeholder.com/110" />
                </label>
                <input type="file" id="profileImage" accept="image/*" onchange="previewImage(event)" />
                <div class="upload-text">Upload photo</div>
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Are You?</label>
                <select>
                    <option>Fresher</option>
                    <option>Experienced</option>
                </select>
            </div>

            <div class="field">
                <label>Date Of Birth</label>
                <input type="date">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>First Name</label>
                <input type="text">
            </div>
            <div class="field">
                <label>Last Name</label>
                <input type="text">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Email</label>
                <input type="text">
            </div>
            <div class="field">
                <label>Phone No.</label>
                <input type="text">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>City</label>
                <input type="text">
            </div>
            <div class="field">
                <label>State</label>
                <input type="text">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Objective</label>
                <textarea rows="4"></textarea>
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Language</label>
                <input type="text">
            </div>
            <div class="field">
                <label>Hobbies</label>
                <input type="text">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Key Achievements</label>
                <input type="text">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>LinkedIn Url</label>
                <input type="url">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label>Projects</label>
                <input type="url">
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">← Back</a>
            <a asp-controller="Create" asp-action="Step2" class="btn btn-primary">Save & Next →</a>
        </div>

    </div>

    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('profilePreview').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>

</body>
</html>
