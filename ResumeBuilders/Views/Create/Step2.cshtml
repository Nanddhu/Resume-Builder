@{
    ViewData["Title"] = "Step 2 - Education";
    Layout = "~/Views/Create/Index.cshtml";
}

<style>
    * {
        box-sizing: border-box;
        font-family: "Segoe UI", sans-serif;
    }

    body {
        margin: 0;
        background: #ffffff;
    }

    .form-wrapper {
        max-width: 900px;
        margin: 40px auto;
    }

    .form-card {
        background: #ffffff;
        padding: 40px;
        border-radius: 14px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }

    h2 {
        color: #1f2937;
        margin-bottom: 8px;
    }

    .subtitle {
        color: #6b7280;
        margin-bottom: 30px;
    }

    .section-title {
        color: #1975B8;
        font-size: 18px;
        font-weight: 600;
        margin: 30px 0 15px;
    }

    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .field {
        flex: 1 1 48%;
        min-width: 280px;
    }


    label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #374151;
    }

    input, select {
        width: 100%;
        padding: 12px 14px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        font-size: 14px;
    }

        input:focus, select:focus {
            outline: none;
            border-color: #1975B8;
        }

    /* Schooling card */
    .school-card {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        position: relative;
    }

    .remove-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: none;
        border: none;
        color: #b91c1c;
        font-weight: 600;
        cursor: pointer;
    }

    .add-btn {
        background: #f3e6ec;
        color: #1975B8;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
    }

        .add-btn:hover {
            background: #e9d3dd;
        }

    /* Actions */
    .actions {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn {
        padding: 14px 30px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-secondary {
        background: #f3e6ec;
        color: #1975B8;
    }

    .btn-primary {
        background: #1975B8;
        color: #ffffff;
    }

        .btn-primary:hover {
            background: #1975B8;
        }
</style>
<body>

    <div class="form-wrapper">
        <div class="form-card">

            <h2>Education</h2>
            <p class="subtitle">Add your education details</p>
            <div id="qualificationBlock">

                <!-- Highest Qualification -->
                <div class="section-title">Qualification</div>

                <div class="row">
                    <div class="field">
                        <label>Highest Qualification</label>
                        <input type="text" placeholder="B.E / B.Tech">
                    </div>
                    <div class="field">
                        <label>Stream</label>
                        <input type="text" placeholder="Computer Science">
                    </div>
                </div>

                <div class="row">
                    <div class="field">
                        <label>Institute</label>
                        <input type="text" placeholder="College / University name">
                    </div>
                </div>

                <div class="row">
                    <div class="field">
                        <label>From</label>
                        <input type="number" placeholder="2019">
                    </div>
                    <div class="field">
                        <label>To</label>
                        <input type="number" placeholder="2023">
                    </div>
                    <div class="field">
                        <label>CGPA / Percentage</label>
                        <input type="text" placeholder="8.2 / 82%">
                    </div>
                </div>
            </div>
            <button type="button" class="add-btn" onclick="addCollege()">
                + Add Qualification
            </button>

            <div class="section-title">HSC / Diplamo</div>

            <div class="row">
                <div class="field">
                    <label>Qualification</label>
                    <input type="text" placeholder="12/Diplamo">
                </div>
                <div class="field">
                    <label>Board/University</label>
                    <input type="text" placeholder="Board/University">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>Institute</label>
                    <input type="text" placeholder="School/College Name">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>From</label>
                    <input type="number" placeholder="2018">
                </div>
                <div class="field">
                    <label>To</label>
                    <input type="number" placeholder="2019">
                </div>
                <div class="field">
                    <label> Percentage</label>
                    <input type="text" placeholder="82%">
                </div>
            </div>
            <div class="section-title">SSLC</div>

            <div class="row">
                <div class="field">
                    <label>Qualification</label>
                    <input type="text" placeholder="10">
                </div>
                <div class="field">
                    <label>Board</label>
                    <input type="text" placeholder="Board">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>Institute</label>
                    <input type="text" placeholder="School Name">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>From</label>
                    <input type="number" placeholder="2016">
                </div>
                <div class="field">
                    <label>To</label>
                    <input type="number" placeholder="2017">
                </div>
                <div class="field">
                    <label> Percentage</label>
                    <input type="text" placeholder="82%">
                </div>
            </div>



            <div id="schoolContainer"></div>



            <!-- Actions -->
            <div class="actions">
                <a asp-controller="Create" asp-action="Step1" class="btn btn-secondary">
                    ← Back
                </a>
                <a asp-controller="Create" asp-action="Step3" class="btn btn-primary">Save & Next →</a>
                   
            </div>

        </div>
    </div>

    <script>
        function addCollege() {
            const container = document.getElementById("schoolContainer");
            const qualificationBlock=document.getElementById("qualificationBlock");

            const div = document.createElement("div");
            div.className = "school-card";

            div.innerHTML = `
                <button class="remove-btn" onclick="this.parentElement.remove()">✕</button>


             <div class="row">
                <div class="field">
                    <label>Degree</label>
                    <input type="text" placeholder="B.E / B.Tech">
                </div>
                <div class="field">
                    <label>Specialization</label>
                    <input type="text" placeholder="Computer Science">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>Institute</label>
                    <input type="text" placeholder="College / University name">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>From</label>
                    <input type="number" placeholder="2019">
                </div>
                <div class="field">
                    <label>To</label>
                    <input type="number" placeholder="2023">
                </div>
                <div class="field">
                    <label>CGPA / Percentage</label>
                    <input type="text" placeholder="8.2 / 82%">
                </div>
            </div>
            `;

            qualificationBlock.after(div);
        }
    </script>
</body>