@model List<ResumeBuilders.Models.ViewModels.ResumeListViewModel>

@{
    ViewData["Title"] = "Dashboard";
}



<div class="dashboard-bg">

    <!-- Search Bar -->
    <div class="search-wrapper">
        <input type="text" id="searchInput" placeholder="Search by candidate name or resume type..." />
    </div>

    <!-- Table Card -->
    <div class="dashboard-card">

        <div class="card-header">
            <h3>My Resumes</h3>
            <span>@Model.Count resumes</span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Candidate Name</th>
                    <th>Resume Type</th>
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th>Created By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <strong>@r.Name</strong>
                            <div class="small-text">@r.ResumeId</div>
                        </td>

                        <td>
                            <span class="badge">Developer</span>
                        </td>

                        <td>
                            @r.CreatedAt.ToString("MM dd, yyyy")
                            <div class="small-text">@r.CreatedAt.ToString("hh:mm tt")</div>
                        </td>

                        <td>
                            @r.UpdatedAt.ToString("MM dd, yyyy")
                            <div class="small-text">@r.UpdatedAt.ToString("hh:mm tt")</div>
                        </td>

                        <td>@r.CreatedBy</td>

                        <td>
                            <div class="actions">
                                <a asp-action="View" asp-route-id="@r.ResumeId">👁</a>
                                <a asp-action="EditResume" asp-route-id="@r.ResumeId">✏</a>
                                <a asp-action="DeleteResume"
                                   asp-route-id="@r.ResumeId"
                                   onclick="return confirm('Delete resume?')">🗑</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <a asp-action="Create" asp-controller="Resume" class="create-btn">
        + Create New Resume
    </a>
</div>


<style>
    body {
        margin: 0;
        font-family: "Segoe UI", sans-serif;
    }

    .dashboard-bg {
        min-height: 100vh;
        background: linear-gradient(135deg,#e8f7fb,#dff5fb);
        padding: 80px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .search-wrapper {
        width: 1100px;
        max-width: 100%;
        background: white;
        padding: 18px 22px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
        margin-bottom: 40px;
    }

        .search-wrapper input {
            width: 100%;
            border: none;
            font-size: 16px;
            outline: none;
        }

    .dashboard-card {
        width: 1100px;
        max-width: 100%;
        background: white;
        border-radius: 16px;
        box-shadow: 0 15px 40px rgba(0,0,0,.12);
        overflow: hidden;
    }

    .card-header {
        padding: 22px 26px;
        display: flex;
        justify-content: space-between;
        font-weight: 600;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f5f7fa;
    }

    th, td {
        padding: 16px 18px;
        text-align: left;
        font-size: 14px;
    }

    tbody tr {
        border-top: 1px solid #eee;
    }

    .small-text {
        font-size: 12px;
        color: #777;
        margin-top: 4px;
    }

    .badge {
        background: #e3efff;
        color: #2979ff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

        .actions a {
            border: 1px solid #ddd;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 15px;
            background: white;
        }

            .actions a:hover {
                background: #eef6ff;
            }

    .create-btn {
        margin-top: 35px;
        background: #2563eb;
        color: white;
        padding: 14px 36px;
        border-radius: 12px;
        font-size: 16px;
        text-decoration: none;
        font-weight: 600;
    }
</style>
