@model ResumeBuilders.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - ProfileMaker</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            margin: 0;
            background: #ffffff;
        }

        .auth-container {
            display: flex;
            min-height: 100vh;
            flex-wrap: wrap;
        }

        .auth-left {
            width: 45%;
            background: linear-gradient(135deg, #1eb8eb, #212529);
            color: #ffffff;
            padding: 100px 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .auth-left h1 {
                font-size: 36px;
                margin-bottom: 32px;
                line-height: 1.3;
            }

        .feature {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 22px;
            font-size: 15px;
            line-height: 1.6;
            opacity: 0.95;
        }

        .feature-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;
            border-radius: 50%;
            background: rgba(255,255,255,0.18);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .feature-icon svg {
                width: 18px;
                height: 18px;
                stroke: #ffffff;
                stroke-width: 2;
                fill: none;
            }

        .auth-right {
            width: 55%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding-top: 40px;
        }

        .auth-card {
            width: 420px;
            margin-top: -40px;
        }

            .auth-card h2 {
                font-size: 28px;
                margin-bottom: 6px;
            }

            .auth-card p {
                font-size: 14px;
                color: #6b7280;
                margin-bottom: 28px;
            }

        .form-group {
            margin-bottom: 18px;
            position: relative;
        }

            .form-group input {
                width: 100%;
                padding: 14px 16px;
                padding-right: 45px;
                border-radius: 8px;
                border: 2px solid #d1d5db;
                font-size: 14px;
                transition: border-color 0.3s;
            }

                .form-group input:focus {
                    outline: none;
                    border-color: ##1eb8eb;
                }

                .form-group input.input-error {
                    border-color: #dc2626;
                    background-color: #fef2f2;
                }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .password-toggle svg {
                width: 20px;
                height: 20px;
                stroke: #6b7280;
                stroke-width: 2;
                fill: none;
            }

        .error-message {
            color: #dc2626;
            font-size: 12px;
            margin-top: 6px;
            display: block;
        }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: #1eb8eb;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
        }

            .btn-primary:hover {
                background: #1975B8;
            }

        .auth-footer {
            margin-top: 18px;
            font-size: 14px;
            text-align: center;
        }

            .auth-footer a {
                color: #1eb8eb;
                text-decoration: none;
                font-weight: 500;
            }

        .general-error {
            background-color: #fee;
            color: #dc2626;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <div class="auth-container">
        <div class="auth-left">
            <h1>Create a resume you are proud of</h1>

            <div class="feature">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 3"></path>
                    </svg>
                </span>
                <div>Save time with hassle-free resume templates</div>
            </div>

            <div class="feature">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <circle cx="12" cy="12" r="4"></circle>
                    </svg>
                </span>
                <div>Beat the competition with actionable resume tips</div>
            </div>

            <div class="feature">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2l2.5 6L21 10l-6 2-2.5 6-2.5-6-6-2 6-2z"></path>
                    </svg>
                </span>
                <div>Highlight achievements with clean, modern visuals</div>
            </div>
        </div>

        <div class="auth-right">
            <div class="auth-card">
                <h2>Welcome back</h2>
                <p>Log in to continue building your resume</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    var generalErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault();
                    if (generalErrors != null)
                    {
                        <div class="general-error">
                            @generalErrors.ErrorMessage
                        </div>
                    }
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <input asp-for="Email" type="email" placeholder="Email*"
                               class="@(ViewData.ModelState.ContainsKey("Email") && !ViewData.ModelState["Email"].ValidationState.ToString().Contains("Valid") ? "input-error" : "")" />
                        <span asp-validation-for="Email" class="error-message"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Password" type="password" placeholder="Password*" id="passwordInput"
                               class="@(ViewData.ModelState.ContainsKey("Password") && !ViewData.ModelState["Password"].ValidationState.ToString().Contains("Valid") ? "input-error" : "")" />
                        <button type="button" class="password-toggle" onclick="togglePassword('passwordInput', 'eyeIcon')">
                            <svg id="eyeIcon" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                        <span asp-validation-for="Password" class="error-message"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        Login
                    </button>
                </form>

                <div class="auth-footer">
                    Don't have an account?
                    <a href="/Auth/Signup">Sign up</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const eyeIcon = document.getElementById(iconId);

            if (input.type === 'password') {
                input.type = 'text';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('input[type="text"], input[type="email"], input[type="password"]');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.remove('input-error');
                    }
                });
            });
        });
    </script>
</body>
</html>