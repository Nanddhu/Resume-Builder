<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ProfileMaker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 20px;
        }

        .card {
            flex: 1 1 300px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #eee;
            background: #fff;
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: 700;
            text-decoration: none;
            color: inherit;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: #000;
            font-size: 15px;
            font-weight: 500;
        }

        .signup-btn {
            background: #1eb8eb;
            color: #fff !important;
            padding: 10px 22px;
            border-radius: 8px;
        }

        
    </style>
</head>

<body>

    <header>
        <a href="/" class="logo-section">

            <!-- ✅ LOGO IMAGE (THIS IS THE FIX) -->
            <img src="/image1/Kf-logo.png"
                 alt="Page Logo"
                 width="48"
                 height="48" />

            <!-- ✅ TEXT -->
            <span>
                <span style="color:#000;">Profile</span>
                <span style="color:#1eb8eb;">Maker</span>
            </span>

        </a>

        <div class="nav-links">
            <a asp-controller="Auth" asp-action="Login">Login</a>
            <a asp-controller="Auth" asp-action="Signup" class="signup-btn">Sign Up</a>
        </div>
    </header>

    @RenderBody()

</body>
</html>

</html>
