<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ProfileMaker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 20px;
        }

        .card {
            flex: 1 1 300px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #eee;
            background: #fff;
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: 700;
            text-decoration: none;
            color: inherit;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: #000;
            font-size: 15px;
            font-weight: 500;
        }

        .signup-btn {
            background: #1eb8eb;
            color: #fff !important;
            padding: 10px 22px;
            border-radius: 8px;
        }

        .logout-btn {
    background: linear-gradient(135deg, #ff1a1a 0%, #ff0000 100%);
    position: relative;
    overflow: hidden;
}

.logout-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.25),
        transparent
    );
    transition: left 0.5s ease;
}

.logout-btn:hover::before {
    left: 100%;
}

.logout-btn:active {
    transform: scale(0.97);
}


        
    </style>
</head>

<body>

    <header>
        <a href="/" class="logo-section">

            <!-- ✅ LOGO IMAGE (THIS IS THE FIX) -->
            <img src="/image1/Kf-logo.png"
                 alt="Page Logo"
                 width="48"
                 height="48" />

            <!-- ✅ TEXT -->
            <span>
                <span style="color:#000;">Profile</span>
                <span style="color:#1eb8eb;">Maker</span>
            </span>

        </a>

        <div class="nav-links">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <!-- LOGGED IN -->
                <span style="font-weight:600;">
                    Hi, @Context.Session.GetString("UserName")
                </span>

                <a asp-controller="Dashboard" asp-action="Index">
                    Dashboard
                </a>

                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                    <button type="submit" id="btn-logout" class="logout-btn group flex items-center gap-2 px-5 py-2.5
            rounded-xl font-semibold text-white shadow-lg transition-all duration-300
            hover:shadow-xl hover:-translate-y-0.5 focus:outline-none">

                        <!-- Icon -->
                        <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-x-0.5"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1
                         a3 3 0 01-3 3H6a3 3 0 01-3-3V7
                         a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>

                        <span>Logout</span>
                    </button>
                </form>
            }
            else
            {
                <!-- NOT LOGGED IN -->
                <a asp-controller="Auth" asp-action="Login">Login</a>
                <a asp-controller="Auth" asp-action="Signup" class="signup-btn">Sign Up</a>
            }
        </div>
    </header>

    @RenderBody()

    <script>
        document.addEventListener("click", function (e) {
            if (!e.target.closest(".logout-btn")) return;

            const btn = e.target.closest(".logout-btn");
            const rect = btn.getBoundingClientRect();
            const ripple = document.createElement("span");
            const size = Math.max(rect.width, rect.height);

            ripple.style.width = ripple.style.height = size + "px";
            ripple.style.left = (e.clientX - rect.left - size / 2) + "px";
            ripple.style.top = (e.clientY - rect.top - size / 2) + "px";
            ripple.style.position = "absolute";
            ripple.style.borderRadius = "50%";
            ripple.style.background = "rgba(255,255,255,0.35)";
            ripple.style.animation = "ripple 0.6s linear";
            ripple.style.pointerEvents = "none";

            btn.appendChild(ripple);
            setTimeout(() => ripple.remove(), 600);
        });
    </script>

    <style>
        @@keyframes ripple {
            from {
                transform: scale(0);
                opacity: 0.6;
            }

            to {
                transform: scale(4);
                opacity: 0;
            }
        }
    </style>


</body>
</html>

</html>
