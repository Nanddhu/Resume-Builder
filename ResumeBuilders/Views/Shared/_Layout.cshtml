<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ProfileMaker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<body style="margin:0;font-family:'Segoe UI', sans-serif;">

    <header style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:20px 70px;
        border-bottom:1px solid #eee;
        background:#fff;
    ">

       
        <a href="/" style="text-decoration:none;">
            <div style="
                display:flex;
                align-items:center;
                gap:10px;
                font-size:22px;
                font-weight:700;
            ">

                
                <svg width="28" height="28" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="pmGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#6b0f3f" />
                            <stop offset="100%" stop-color="#8b1d5a" />
                        </linearGradient>
                    </defs>

                    
                    <rect x="10" y="8" rx="8" ry="8" width="44" height="48" fill="url(#pmGrad)" />
                   
                    <circle cx="32" cy="22" r="6" fill="#ffffff" />
                    
                    <rect x="20" y="34" width="24" height="3" rx="1.5" fill="#ffffff" />
                    <rect x="20" y="40" width="18" height="3" rx="1.5" fill="#ffffff" />
                </svg>

                
                <span>
                    <span style="color:#000;">Profile</span>
                    <span style="color:#6b0f3f;">Maker</span>
                </span>
            </div>
        </a>

       
        <div style="display:flex;gap:20px;align-items:center;">
            <a asp-controller="Auth"
               asp-action="Login"
               style="
                text-decoration:none;
                color:#000;
                font-size:15px;
                font-weight:500;
            ">
                Login
            </a>

            <a asp-controller="Auth"
               asp-action="Signup"
               style="
                text-decoration:none;
                background:#6b0f3f;
                color:#fff;
                padding:10px 22px;
                border-radius:8px;
                font-size:15px;
                font-weight:500;
            ">
                Sign Up
            </a>
        </div>
    </header>

    @RenderBody()

</body>
</html>
