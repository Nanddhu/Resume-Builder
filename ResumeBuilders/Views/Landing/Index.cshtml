@{
    ViewData["Title"] = "Home";
}

<style>
   
    .hero {
        display: flex;
        justify-content: space-between;
        padding: 90px 120px;
        background: #f6edf2;
        align-items:center;
        min-height:calc(100vh-80px);
    }

    .hero-left {
        width: 45%;
        margin-top: -100px;
    }

        .hero-left h1 {
            font-size: 48px;
            margin-bottom: 20px;
        }

        .hero-left p {
            font-size: 18px;
            color: #4b5563;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .cta {
            display: inline-block;
            background: #6b0f3f;
            color: #fff;
            padding: 14px 32px;
            font-size: 16px;
            border-radius: 10px;
            text-decoration: none;
        }


    .hero-meta {
        margin-top: 40px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 14px;
        color: #4b5563;
    }
    .hero-footer {
        margin-top: 50px;
        max-width: 380px;
    }

    .footer-line {
        width: 60px;
        height: 3px;
        background: #6b0f3f;
        margin-bottom: 12px;
        border-radius: 2px;
    }

    .hero-footer p {
        font-size: 14px;
        color: #6b7280;
    }



  
    .hero-right {
        width: 40%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top:-50px;
    }

  
    .resume-flip {
        width: 360px;
        height: 460px;
        perspective: 1200px;
    }

   
    .resume-card {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.8s ease;
    }

    .resume-flip:hover .resume-card {
        transform: rotateY(180deg);
    }

  
    .resume-side {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0,0,0,0.18);
        background: #fff;
    }

        
        .resume-side img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

   
    .resume-back {
        transform: rotateY(180deg);
    }

</style>

<section class="hero">
   
    <div class="hero-left">
        <h1>Build a resume<br />that gets noticed</h1>
        <p>
            Create a professional, ATS-friendly resume in minutes.
            Clean design. Simple editing. Recruiter-ready.
        </p>
        <a asp-controller="Auth"
           asp-action="Signup"
           class="cta">
            Build Your Resume
        </a>
        <div class="hero-meta">
            <div class="meta-item">✔ ATS-friendly templates</div>
            <div class="meta-item">✔ Recruiter-approved designs</div>
            <div class="meta-item">✔ Build & download in minutes</div>
        </div>
        <div class="hero-footer">
            <div class="footer-line"></div>
            <p>Designed to help you stand out — not blend in.</p>
        </div>


    </div>

  
    <div class="hero-right">
        <div class="resume-flip">
            <div class="resume-card">

                <div class="resume-side resume-front">
                    <img src="~/images/eg resume.jpg" alt="Resume Front" />
                </div>

               
                <div class="resume-side resume-back">
                    <img src="~/images/homepage-hero (2).png" alt="Resume Back" />
                </div>

            </div>
        </div>
    </div>

</section>
